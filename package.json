{
  "name": "network-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.0",
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=11.12.0 <12"
  },
  "volta": {
    "node": "22.22.3",
    "npm": "11.12.0"
  },
  "scripts": {
    "start": "nx serve",
    "start:safe": "nx serve --prebundle=false",
    "build": "nx build",
    "prod": "npm run build && npm run preview",
    "preview": "serve dist/network-planner/browser -l 4000",
    "lint:all": "nx run-many -t lint",
    "test": "nx test network-planner",
    "e2e": "playwright test --workers=1",
    "e2e:ui": "playwright test --ui",
    "e2e:browser": "playwright test --headed --workers=1",
    "e2e:debug": "playwright test --debug=inspector",
    "e2e:list": "playwright test --list",
    "e2e:report": "playwright show-report",
    "generate:page": "nx g c --type=page",
    "generate:component": "nx g c --type=component",
    "cache:clean": "nx cache clean"
  },
  "dependencies": {
    "@angular/animations": "22.2.5",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/platform-browser-dynamic": "22.2.5",
    "@angular/platform-server": "22.2.5",
    "@angular/router": "22.2.5",
    "@angular/ssr": "22.2.6",
    "@lucide/angular": "^1.57.0",
    "@sigma/export-image": "^4.0.0",
    "@sigma/node-border": "^4.0.0",
    "chart.js": "^4.6.1",
    "driver.js": "^1.10.2",
    "express": "^5.1.0",
    "graphology": "^0.26.0",
    "graphology-generators": "^0.11.2",
    "graphology-types": "^0.24.8",
    "rxjs": "^7.8.0",
    "sigma": "^4.0.1",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2202.6",
    "@angular-devkit/core": "22.2.6",
    "@angular-devkit/schematics": "22.2.6",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "24.0.5",
    "@nx/eslint": "24.0.5",
    "@nx/eslint-plugin": "24.0.5",
    "@nx/js": "24.0.5",
    "@nx/workspace": "24.0.5",
    "@playwright/test": "^1.64.1",
    "@schematics/angular": "22.2.6",
    "@swc/helpers": "~0.5.18",
    "@types/express": "^5.0.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^30.1.3",
    "nx": "24.0.5",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
