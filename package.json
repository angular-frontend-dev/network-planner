{
  "name": "network-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.0",
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=8.0.0"
  },
  "volta": {
    "node": "22.22.3",
    "npm": "11.12.0"
  },
  "scripts": {
    "start": "ng serve",
    "start:safe": "ng serve --prebundle=false",
    "build": "ng build",
    "prod": "npm run build && npm run preview",
    "preview": "node dist/network-planner/server/server.mjs",
    "test": "ng test network-planner",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:browser": "playwright test --headed --workers=1",
    "e2e:debug": "playwright test --debug",
    "e2e:list": "playwright test --list",
    "e2e:report": "playwright show-report",
    "generate:page": "ng g c --type=page",
    "generate:component": "ng g c --type=component",
    "cache:clean": "ng cache clean"
  },
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "@lucide/angular": "^1.57.0",
    "@sigma/export-image": "^4.0.0",
    "@sigma/node-border": "^4.0.0",
    "chart.js": "^4.6.1",
    "express": "^5.1.0",
    "graphology": "^0.26.0",
    "graphology-generators": "^0.11.2",
    "graphology-types": "^0.24.8",
    "rxjs": "^7.8.0",
    "sigma": "^4.0.1",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.20.5",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
